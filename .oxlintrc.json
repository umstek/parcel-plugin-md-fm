{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    ".parcel-cache/**",
    "example/dist/**",
    "test/integration/fixture/dist/**"
  ],
  "env": {
    "node": true,
    "commonjs": true
  }
}
